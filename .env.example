# Client
VITE_SERVER_URL=http://localhost:2567

# Server
PORT=2567
# Automated verification can shorten meteor waits without changing production balance.
METEOR_INTERVAL_SCALE=1
# Score persistence: "file" (default) or "none".
SCORE_STORE=file
# Where the file store writes. Defaults to <server cwd>/data/scores.json.
# Hosts with an ephemeral disk, Render Free among them, wipe this on restart;
# swap in a database implementation of ScoreStore when that matters.
SCORE_STORE_PATH=

